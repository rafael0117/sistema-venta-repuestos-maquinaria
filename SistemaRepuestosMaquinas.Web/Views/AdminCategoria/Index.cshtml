@model SistemaRepuestosMaquinas.Web.Models.AdminCategoriaPageViewModel
@{
    ViewData["Title"] = "CRUD Categorías";
}

<h1 class="mb-3">Admin · CRUD Categorías</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">
        @Model.Message
    </div>
}

<div class="card mb-3">
    <div class="card-header">Nueva categoría</div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2">
            @Html.AntiForgeryToken()

            <div class="col-md-4">
                <input asp-for="Form.Nombre" class="form-control" placeholder="Nombre" required />
            </div>

            <div class="col-md-6">
                <input asp-for="Form.Descripcion" class="form-control" placeholder="Descripción" />
            </div>

            <div class="col-md-2">
                <select asp-for="Form.Estado" class="form-control">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
            </div>

            <div class="col-12">
                <button class="btn btn-success">Crear</button>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>
                <td>@x.IdCategoria</td>

                <td>
                    <input form="form-@x.IdCategoria" name="Nombre" value="@x.Nombre" class="form-control" />
                </td>

                <td>
                    <input form="form-@x.IdCategoria" name="Descripcion" value="@x.Descripcion" class="form-control" />
                </td>

                <td>
                    <span class="badge @(x.Estado ? "bg-success" : "bg-secondary")">
                        @(x.Estado ? "Activo" : "Inactivo")
                    </span>
                </td>

                <td class="d-flex gap-1">

                    <!-- UPDATE -->
                    <form id="form-@x.IdCategoria" asp-action="Update" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdCategoria" value="@x.IdCategoria" />
                        <input type="hidden" name="Estado" value="@x.Estado.ToString().ToLower()" />
                        <button class="btn btn-primary btn-sm">Guardar</button>
                    </form>

                    <!-- TOGGLE -->
                    <form asp-action="ToggleEstado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@x.IdCategoria" />
                        <input type="hidden" name="estadoActual" value="@x.Estado.ToString().ToLower()" />
                        <button class="btn btn-warning btn-sm">Estado</button>
                    </form>

                    <!-- DELETE -->
                    <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@x.IdCategoria" />
                        <button class="btn btn-danger btn-sm">Eliminar</button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>