@model SistemaRepuestosMaquinas.Web.Models.AdminMarcaPageViewModel
@{ ViewData["Title"] = "Admin Marcas"; }
<h1 class="mb-3">Admin · Marcas</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.IsError?"alert-danger":"alert-success")">@Model.Message</div> }
<div class="card mb-3"><div class="card-header">Nueva marca</div><div class="card-body">
<form asp-action="Create" method="post" class="row g-2">@Html.AntiForgeryToken()
<div class="col-md-8"><label class="form-label">Nombre</label><input asp-for="Form.Nombre" class="form-control" required /></div>
<div class="col-md-4 align-self-end"><button class="btn btn-success" type="submit">Crear</button></div>
</form></div></div>
<table class="table table-striped"><thead><tr><th>Id</th><th>Nombre</th><th></th></tr></thead><tbody>
@foreach (var x in Model.Items){<tr><td>@x.IdMarca</td><td>@x.Nombre</td><td><form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdMarca"/><button class="btn btn-danger btn-sm">Eliminar</button></form></td></tr>}
</tbody></table>
