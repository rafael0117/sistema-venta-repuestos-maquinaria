@model SistemaRepuestosMaquinas.Web.Models.AdminProductoPageViewModel
@{ ViewData["Title"] = "Admin Productos"; }
<h1 class="mb-3">Admin · Productos</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.IsError?"alert-danger":"alert-success")">@Model.Message</div> }
<div class="card mb-3"><div class="card-header">Nuevo producto</div><div class="card-body">
<form asp-action="Create" method="post" class="row g-2">@Html.AntiForgeryToken()
<div class="col-md-2"><label class="form-label">Código</label><input asp-for="Form.Codigo" class="form-control" required /></div>
<div class="col-md-3"><label class="form-label">Nombre</label><input asp-for="Form.Nombre" class="form-control" required /></div>
<div class="col-md-2"><label class="form-label">IdCategoria</label><input asp-for="Form.IdCategoria" class="form-control" type="number" required /></div>
<div class="col-md-2"><label class="form-label">IdMarca</label><input asp-for="Form.IdMarca" class="form-control" type="number" required /></div>
<div class="col-md-2"><label class="form-label">Precio</label><input asp-for="Form.PrecioVenta" class="form-control" type="number" step="0.01" required /></div>
<div class="col-md-1"><label class="form-label">Stock</label><input asp-for="Form.Stock" class="form-control" type="number" required /></div>
<div class="col-md-12"><label class="form-label">Descripción</label><input asp-for="Form.Descripcion" class="form-control" /></div>
<div class="col-md-3 align-self-end"><button class="btn btn-success" type="submit">Crear</button></div>
</form></div></div>
<table class="table table-striped"><thead><tr><th>Id</th><th>Código</th><th>Nombre</th><th>Precio</th><th>Stock</th><th></th></tr></thead><tbody>
@foreach (var x in Model.Items){<tr><td>@x.IdProducto</td><td>@x.Codigo</td><td>@x.Nombre</td><td>S/ @x.PrecioVenta</td><td>@x.Stock</td><td><form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdProducto" /><button class="btn btn-danger btn-sm">Eliminar</button></form></td></tr>}
</tbody></table>
