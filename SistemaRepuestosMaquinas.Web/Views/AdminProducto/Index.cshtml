@model SistemaRepuestosMaquinas.Web.Models.AdminProductoPageViewModel
@{ ViewData["Title"] = "CRUD Productos"; }
<h1 class="mb-3">Admin · CRUD Productos</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.IsError?"alert-danger":"alert-success")">@Model.Message</div> }
<div class="card mb-3"><div class="card-header">Nuevo producto</div><div class="card-body">
<form asp-action="Create" method="post" class="row g-2">@Html.AntiForgeryToken()
<div class="col-md-2"><label class="form-label">Código</label><input asp-for="Form.Codigo" class="form-control" required /></div>
<div class="col-md-2"><label class="form-label">Nombre</label><input asp-for="Form.Nombre" class="form-control" required /></div>
<div class="col-md-2"><label class="form-label">IdCategoría</label><input asp-for="Form.IdCategoria" class="form-control" type="number" required /></div>
<div class="col-md-2"><label class="form-label">IdMarca</label><input asp-for="Form.IdMarca" class="form-control" type="number" required /></div>
<div class="col-md-2"><label class="form-label">Precio</label><input asp-for="Form.PrecioVenta" class="form-control" type="number" step="0.01" required /></div>
<div class="col-md-1"><label class="form-label">Stock</label><input asp-for="Form.Stock" class="form-control" type="number" required /></div>
<div class="col-md-1"><label class="form-label">Mínimo</label><input asp-for="Form.StockMinimo" class="form-control" type="number" required /></div>
<div class="col-md-10"><label class="form-label">Descripción</label><input asp-for="Form.Descripcion" class="form-control" /></div>
<div class="col-md-2"><label class="form-label">Estado</label><select asp-for="Form.Estado" class="form-control"><option value="true">Activo</option><option value="false">Inactivo</option></select></div>
<div class="col-12"><button class="btn btn-success" type="submit">Crear</button></div>
</form></div></div>
<table class="table table-striped table-sm"><thead><tr><th>Id</th><th>Código</th><th>Nombre</th><th>Precio</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var x in Model.Items){
<tr>
<td>@x.IdProducto</td>
<td><form asp-action="Update" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()
<input type="hidden" name="IdProducto" value="@x.IdProducto"/>
<input name="Codigo" value="@x.Codigo" class="form-control form-control-sm" required/></td>
<td><input name="Nombre" value="@x.Nombre" class="form-control form-control-sm" required/></td>
<td><input name="PrecioVenta" value="@x.PrecioVenta" class="form-control form-control-sm" type="number" step="0.01" required/></td>
<td><input name="Stock" value="@x.Stock" class="form-control form-control-sm" type="number" required/></td>
<td>
<input type="hidden" name="IdCategoria" value="@x.IdCategoria"/>
<input type="hidden" name="IdMarca" value="@x.IdMarca"/>
<input type="hidden" name="Descripcion" value="@x.Descripcion"/>
<input type="hidden" name="StockMinimo" value="@x.StockMinimo"/>
<input type="hidden" name="ImagenUrl" value="@x.ImagenUrl"/>
<input type="hidden" name="Estado" value="@x.Estado.ToString().ToLower()"/>
<span class="badge @(x.Estado?"bg-success":"bg-secondary")">@(x.Estado?"Activo":"Inactivo")</span>
</td>
<td class="d-flex gap-1">
<button class="btn btn-primary btn-sm" type="submit">Guardar</button></form>
<form asp-action="ToggleEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdProducto"/><input type="hidden" name="estadoActual" value="@x.Estado.ToString().ToLower()"/><button class="btn btn-warning btn-sm">Estado</button></form>
<form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar producto?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdProducto" /><button class="btn btn-danger btn-sm">Eliminar</button></form>
</td>
</tr>}
</tbody></table>
