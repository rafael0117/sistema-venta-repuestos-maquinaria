@model SistemaRepuestosMaquinas.Web.Models.AdminProductoPageViewModel
@{
    ViewData["Title"] = "CRUD Productos";
}

<h1 class="mb-3">Admin · CRUD Productos</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">
        @Model.Message
    </div>
}

<div class="card mb-3">
    <div class="card-header">Nuevo producto</div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2">
            @Html.AntiForgeryToken()

            <div class="col-md-2">
                <input asp-for="Form.Codigo" class="form-control" placeholder="Código" required />
            </div>

            <div class="col-md-2">
                <input asp-for="Form.Nombre" class="form-control" placeholder="Nombre" required />
            </div>

            <div class="col-md-2">
                <input asp-for="Form.IdCategoria" class="form-control" type="number" placeholder="Categoría" required />
            </div>

            <div class="col-md-2">
                <input asp-for="Form.IdMarca" class="form-control" type="number" placeholder="Marca" required />
            </div>

            <div class="col-md-2">
                <input asp-for="Form.PrecioVenta" class="form-control" type="number" step="0.01" placeholder="Precio" required />
            </div>

            <div class="col-md-1">
                <input asp-for="Form.Stock" class="form-control" type="number" placeholder="Stock" required />
            </div>

            <div class="col-md-1">
                <input asp-for="Form.StockMinimo" class="form-control" type="number" placeholder="Min" required />
            </div>

            <div class="col-md-10">
                <input asp-for="Form.Descripcion" class="form-control" placeholder="Descripción" />
            </div>

            <div class="col-md-2">
                <select asp-for="Form.Estado" class="form-control">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
            </div>

            <div class="col-12">
                <button class="btn btn-success">Crear</button>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Id</th>
            <th>Código</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>
                <td>@x.IdProducto</td>

                <td>
                    <input form="form-@x.IdProducto" name="Codigo" value="@x.Codigo" class="form-control form-control-sm" />
                </td>

                <td>
                    <input form="form-@x.IdProducto" name="Nombre" value="@x.Nombre" class="form-control form-control-sm" />
                </td>

                <td>
                    <input form="form-@x.IdProducto" name="PrecioVenta" value="@x.PrecioVenta" type="number" step="0.01" class="form-control form-control-sm" />
                </td>

                <td>
                    <input form="form-@x.IdProducto" name="Stock" value="@x.Stock" type="number" class="form-control form-control-sm" />
                </td>

                <td>
                    <span class="badge @(x.Estado ? "bg-success" : "bg-secondary")">
                        @(x.Estado ? "Activo" : "Inactivo")
                    </span>
                </td>

                <td class="d-flex gap-1">

                    <!-- UPDATE -->
                    <form id="form-@x.IdProducto" asp-action="Update" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdProducto" value="@x.IdProducto" />
                        <input type="hidden" name="IdCategoria" value="@x.IdCategoria" />
                        <input type="hidden" name="IdMarca" value="@x.IdMarca" />
                        <input type="hidden" name="Descripcion" value="@x.Descripcion" />
                        <input type="hidden" name="StockMinimo" value="@x.StockMinimo" />
                        <input type="hidden" name="ImagenUrl" value="@x.ImagenUrl" />
                        <input type="hidden" name="Estado" value="@x.Estado.ToString().ToLower()" />
                        <button class="btn btn-primary btn-sm">Guardar</button>
                    </form>

                    <!-- TOGGLE -->
                    <form asp-action="ToggleEstado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@x.IdProducto" />
                        <input type="hidden" name="estadoActual" value="@x.Estado.ToString().ToLower()" />
                        <button class="btn btn-warning btn-sm">Estado</button>
                    </form>

                    <!-- DELETE -->
                    <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar producto?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@x.IdProducto" />
                        <button class="btn btn-danger btn-sm">Eliminar</button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>