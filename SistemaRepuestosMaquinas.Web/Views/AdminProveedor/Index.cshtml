@model SistemaRepuestosMaquinas.Web.Models.AdminProveedorPageViewModel
@{ ViewData["Title"] = "Admin Proveedores"; }
<h1 class="mb-3"><i class="fa-solid fa-truck-field"></i> Admin · Proveedores</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.IsError?"alert-danger":"alert-success")">@Model.Message</div> }
<div class="crud-toolbar"><p class="text-muted mb-1">CRUD de proveedores con formulario modal.</p><button type="button" class="btn btn-success" data-open-modal="create-proveedor-modal"><i class="fa-solid fa-plus"></i> Agregar proveedor</button></div>

<div class="table-wrap" data-paginated-table data-page-size="8"><table class="table table-striped"><thead><tr><th>Id</th><th>RUC</th><th>Razón Social</th><th>Teléfono</th><th>Correo</th><th>Acciones</th></tr></thead><tbody>
@foreach (var x in Model.Items){<tr><td>@x.IdProveedor</td><td>@x.Ruc</td><td>@x.RazonSocial</td><td>@x.Telefono</td><td>@x.Correo</td><td class="d-flex gap-1 flex-wrap"><button type="button" class="btn btn-primary btn-sm" data-open-modal="edit-proveedor-modal" data-id="@x.IdProveedor" data-ruc="@x.Ruc" data-razonsocial="@x.RazonSocial" data-telefono="@x.Telefono" data-correo="@x.Correo" data-direccion="@x.Direccion" data-estado="@x.Estado.ToString().ToLower()"><i class="fa-solid fa-pen"></i> Editar</button><form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdProveedor"/><button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Eliminar</button></form></td></tr>}
</tbody></table><div class="pagination-controls" data-pagination-controls></div></div>

<div id="create-proveedor-modal" class="crud-modal-overlay"><div class="crud-modal"><div class="crud-modal-header"><h3>Nuevo proveedor</h3><button type="button" class="modal-close" data-close-modal>✕</button></div><div class="crud-modal-body"><form asp-action="Create" method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label">RUC</label><input asp-for="Form.Ruc" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Razón Social</label><input asp-for="Form.RazonSocial" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Teléfono</label><input asp-for="Form.Telefono" class="form-control" /></div><div class="col-md-4"><label class="form-label">Correo</label><input asp-for="Form.Correo" class="form-control" /></div><div class="col-md-4"><label class="form-label">Dirección</label><input asp-for="Form.Direccion" class="form-control" /></div><div class="col-md-4"><label class="form-label">Estado</label><select asp-for="Form.Estado" class="form-control"><option value="true">Activo</option><option value="false">Inactivo</option></select></div><div class="col-12"><button class="btn btn-success"><i class="fa-solid fa-floppy-disk"></i> Crear</button></div></form></div></div></div>

<div id="edit-proveedor-modal" class="crud-modal-overlay"><div class="crud-modal"><div class="crud-modal-header"><h3>Editar proveedor</h3><button type="button" class="modal-close" data-close-modal>✕</button></div><div class="crud-modal-body"><form asp-action="Update" method="post" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="IdProveedor" id="prov-id"/><div class="col-md-4"><input name="Ruc" id="prov-ruc" class="form-control" required /></div><div class="col-md-4"><input name="RazonSocial" id="prov-razonsocial" class="form-control" required /></div><div class="col-md-4"><input name="Telefono" id="prov-telefono" class="form-control" /></div><div class="col-md-4"><input name="Correo" id="prov-correo" class="form-control" /></div><div class="col-md-4"><input name="Direccion" id="prov-direccion" class="form-control" /></div><div class="col-md-4"><select name="Estado" id="prov-estado" class="form-control"><option value="true">Activo</option><option value="false">Inactivo</option></select></div><div class="col-12"><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Guardar</button></div></form></div></div></div>

@section Scripts {<script>document.querySelectorAll('[data-open-modal="edit-proveedor-modal"]').forEach((b)=>b.addEventListener('click',()=>{const f=(k)=>b.getAttribute('data-'+k)||'';const provId=document.getElementById('prov-id');provId.value=f('id');document.getElementById('prov-ruc').value=f('ruc');document.getElementById('prov-razonsocial').value=f('razonsocial');document.getElementById('prov-telefono').value=f('telefono');document.getElementById('prov-correo').value=f('correo');document.getElementById('prov-direccion').value=f('direccion');document.getElementById('prov-estado').value=f('estado')||'true';}));</script>}
