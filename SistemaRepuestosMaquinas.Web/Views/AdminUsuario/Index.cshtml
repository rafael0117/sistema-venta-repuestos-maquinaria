@model SistemaRepuestosMaquinas.Web.Models.AdminUsuarioPageViewModel
@{ ViewData["Title"] = "CRUD Usuarios"; }
<h1 class="mb-3">Admin · CRUD Usuarios</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.IsError?"alert-danger":"alert-success")">@Model.Message</div> }

<div class="card mb-3"><div class="card-header">Nuevo usuario</div><div class="card-body">
<form asp-action="Create" method="post" class="row g-2">@Html.AntiForgeryToken()
<div class="col-md-2"><label class="form-label">Rol</label><select asp-for="Form.IdRol" class="form-control">@foreach(var r in Model.Roles){<option value="@r.IdRol">@r.Nombre</option>}</select></div>
<div class="col-md-2"><label class="form-label">Nombres</label><input asp-for="Form.Nombres" class="form-control" required /></div>
<div class="col-md-2"><label class="form-label">Apellidos</label><input asp-for="Form.Apellidos" class="form-control" required /></div>
<div class="col-md-3"><label class="form-label">Correo</label><input asp-for="Form.Correo" type="email" class="form-control" required /></div>
<div class="col-md-2"><label class="form-label">Contraseña</label><input asp-for="Form.Password" type="password" class="form-control" required /></div>
<div class="col-md-1"><label class="form-label">Estado</label><select asp-for="Form.Estado" class="form-control"><option value="true">Activo</option><option value="false">Inactivo</option></select></div>
<div class="col-12"><button class="btn btn-success" type="submit">Crear</button></div>
</form></div></div>

<table class="table table-striped table-sm"><thead><tr><th>ID</th><th>Nombres</th><th>Apellidos</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var x in Model.Items){
<tr>
<form asp-action="Update" method="post">@Html.AntiForgeryToken()
<td>@x.IdUsuario<input type="hidden" name="IdUsuario" value="@x.IdUsuario"/></td>
<td><input name="Nombres" value="@x.Nombres" class="form-control form-control-sm" required /></td>
<td><input name="Apellidos" value="@x.Apellidos" class="form-control form-control-sm" required /></td>
<td><input name="Correo" value="@x.Correo" type="email" class="form-control form-control-sm" required /></td>
<td>
<select name="IdRol" class="form-control form-control-sm">
@foreach(var r in Model.Roles){<option value="@r.IdRol" selected="@(r.IdRol == x.IdRol)">@r.Nombre</option>}
</select>
</td>
<td><input type="hidden" name="Estado" value="@x.Estado.ToString().ToLower()"/><span class="badge @(x.Estado?"bg-success":"bg-secondary")">@(x.Estado?"Activo":"Inactivo")</span></td>
<td class="d-flex gap-1 flex-wrap">
<button class="btn btn-primary btn-sm">Guardar</button></form>
<form asp-action="ToggleEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdUsuario"/><input type="hidden" name="estadoActual" value="@x.Estado.ToString().ToLower()"/><button class="btn btn-warning btn-sm">Estado</button></form>
<form asp-action="ResetPassword" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdUsuario"/><input type="password" name="newPassword" placeholder="Nueva contraseña" class="form-control form-control-sm" required /><button class="btn btn-info btn-sm">Reset</button></form>
<form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar usuario?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdUsuario"/><button class="btn btn-danger btn-sm">Eliminar</button></form>
</td>
</tr>
}
</tbody></table>
