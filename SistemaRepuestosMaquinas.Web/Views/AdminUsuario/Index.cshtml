@model SistemaRepuestosMaquinas.Web.Models.AdminUsuarioPageViewModel
@{ ViewData["Title"] = "CRUD Usuarios"; }
<h1 class="mb-3"><i class="fa-solid fa-users-gear"></i> Admin · CRUD Usuarios</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div> }
<div class="crud-toolbar"><p class="text-muted mb-1">Altas y edición de usuarios desde modal.</p><button type="button" class="btn btn-success" data-open-modal="create-usuario-modal"><i class="fa-solid fa-user-plus"></i> Agregar usuario</button></div>

<div class="table-wrap" data-paginated-table data-page-size="8"><table class="table table-striped table-sm"><thead><tr><th>ID</th><th>Nombres</th><th>Apellidos</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var x in Model.Items){<tr><td>@x.IdUsuario</td><td>@x.Nombres</td><td>@x.Apellidos</td><td>@x.Correo</td><td>@x.Rol</td><td><span class="badge @(x.Estado ? "bg-success" : "bg-secondary")">@(x.Estado ? "Activo" : "Inactivo")</span></td><td class="d-flex gap-1 flex-wrap"><button type="button" class="btn btn-primary btn-sm" data-open-modal="edit-usuario-modal" data-id="@x.IdUsuario" data-idrol="@x.IdRol" data-nombres="@x.Nombres" data-apellidos="@x.Apellidos" data-correo="@x.Correo" data-estado="@x.Estado.ToString().ToLower()"><i class="fa-solid fa-pen"></i> Editar</button><form asp-action="ToggleEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdUsuario" /><input type="hidden" name="estadoActual" value="@x.Estado.ToString().ToLower()" /><button class="btn btn-warning btn-sm"><i class="fa-solid fa-power-off"></i> Estado</button></form><form asp-action="ResetPassword" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdUsuario" /><input type="password" name="newPassword" class="form-control form-control-sm" placeholder="Nueva contraseña" required /><button class="btn btn-info btn-sm"><i class="fa-solid fa-key"></i> Reset</button></form><form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar usuario?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.IdUsuario" /><button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Eliminar</button></form></td></tr>}
</tbody></table><div class="pagination-controls" data-pagination-controls></div></div>

<div id="create-usuario-modal" class="crud-modal-overlay"><div class="crud-modal"><div class="crud-modal-header"><h3>Nuevo usuario</h3><button type="button" class="modal-close" data-close-modal>✕</button></div><div class="crud-modal-body"><form asp-action="Create" method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-3"><select asp-for="Form.IdRol" class="form-control">@foreach (var r in Model.Roles){<option value="@r.IdRol">@r.Nombre</option>}</select></div><div class="col-md-3"><input asp-for="Form.Nombres" class="form-control" placeholder="Nombres" required /></div><div class="col-md-3"><input asp-for="Form.Apellidos" class="form-control" placeholder="Apellidos" required /></div><div class="col-md-3"><input asp-for="Form.Correo" type="email" class="form-control" placeholder="Correo" required /></div><div class="col-md-4"><input asp-for="Form.Password" type="password" class="form-control" placeholder="Contraseña" required /></div><div class="col-md-2"><select asp-for="Form.Estado" class="form-control"><option value="true">Activo</option><option value="false">Inactivo</option></select></div><div class="col-12"><button class="btn btn-success"><i class="fa-solid fa-floppy-disk"></i> Crear</button></div></form></div></div></div>
<div id="edit-usuario-modal" class="crud-modal-overlay"><div class="crud-modal"><div class="crud-modal-header"><h3>Editar usuario</h3><button type="button" class="modal-close" data-close-modal>✕</button></div><div class="crud-modal-body"><form asp-action="Update" method="post" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="IdUsuario" id="user-id"/><div class="col-md-3"><select name="IdRol" id="user-idrol" class="form-control">@foreach (var r in Model.Roles){<option value="@r.IdRol">@r.Nombre</option>}</select></div><div class="col-md-3"><input name="Nombres" id="user-nombres" class="form-control" required /></div><div class="col-md-3"><input name="Apellidos" id="user-apellidos" class="form-control" required /></div><div class="col-md-3"><input name="Correo" id="user-correo" class="form-control" required /></div><div class="col-md-3"><select name="Estado" id="user-estado" class="form-control"><option value="true">Activo</option><option value="false">Inactivo</option></select></div><div class="col-12"><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Guardar</button></div></form></div></div></div>

@section Scripts {<script>document.querySelectorAll('[data-open-modal="edit-usuario-modal"]').forEach((b)=>b.addEventListener('click',()=>{const f=(k)=>b.getAttribute('data-'+k)||'';document.getElementById('user-id').value=f('id');document.getElementById('user-idrol').value=f('idrol');document.getElementById('user-nombres').value=f('nombres');document.getElementById('user-apellidos').value=f('apellidos');document.getElementById('user-correo').value=f('correo');document.getElementById('user-estado').value=f('estado')||'true';}));</script>}
