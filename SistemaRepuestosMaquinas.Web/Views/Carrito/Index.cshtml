@model SistemaRepuestosMaquinas.Web.Models.CarritoPageViewModel
@{
    ViewData["Title"] = "Carrito";
}

<h1 class="mb-3">Mi carrito</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
}

@if (!Model.IdCliente.HasValue)
{
    <div class="alert alert-warning">Debes iniciar sesión para gestionar tu carrito.</div>
    <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Index">Ir a login</a>
}
else
{
<h4>Detalle</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Producto</th>
            <th style="width:180px;">Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Detalles)
    {
        <tr>
            <td>@item.Producto (@item.IdProducto)</td>
            <td>
                <div class="d-flex align-items-center gap-2">
                    <form asp-action="ActualizarCantidad" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idCarritoDetalle" value="@item.IdCarritoDetalle" />
                        <input type="hidden" name="cantidad" value="@(item.Cantidad - 1)" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">-</button>
                    </form>
                    <span>@item.Cantidad</span>
                    <form asp-action="ActualizarCantidad" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idCarritoDetalle" value="@item.IdCarritoDetalle" />
                        <input type="hidden" name="cantidad" value="@(item.Cantidad + 1)" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">+</button>
                    </form>
                </div>
            </td>
            <td>S/ @item.PrecioUnitario</td>
            <td>S/ @item.SubTotal</td>
            <td>
                <form asp-action="Eliminar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idCarritoDetalle" value="@item.IdCarritoDetalle" />
                    <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="card mt-3">
    <div class="card-header">Checkout Pro (Mercado Pago)</div>
    <div class="card-body">
        <p class="fw-bold">Total: S/ @Model.Total</p>
        <p class="text-muted small">Serás redirigido a Mercado Pago para completar el pago de forma segura.</p>

        <form asp-action="Checkout" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label asp-for="DireccionEntrega" class="form-label">Dirección de entrega</label>
                <input asp-for="DireccionEntrega" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label asp-for="EmailPago" class="form-label">Email de pago</label>
                <input asp-for="EmailPago" class="form-control" placeholder="comprador@test.com" required />
            </div>
            <div class="col-md-3 align-self-end">
                <button class="btn btn-success" type="submit">Pagar con Checkout Pro</button>
            </div>
        </form>
    </div>
</div>
}
