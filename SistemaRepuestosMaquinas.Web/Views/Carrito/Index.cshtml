@model SistemaRepuestosMaquinas.Web.Models.CarritoPageViewModel
@{
    ViewData["Title"] = "Carrito";
}

<h1 class="mb-3">Mi carrito</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
}

@if (!Model.IdCliente.HasValue)
{
    <div class="alert alert-warning">Debes iniciar sesión para gestionar tu carrito.</div>
    <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Index">Ir a login</a>
}
else
{
<h4>Detalle</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Producto</th>
            <th style="width:180px;">Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Detalles)
    {
        <tr>
            <td>@item.Producto (@item.IdProducto)</td>
            <td>
                <div class="d-flex align-items-center gap-2">
                    <form asp-action="ActualizarCantidad" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idCarritoDetalle" value="@item.IdCarritoDetalle" />
                        <input type="hidden" name="cantidad" value="@(item.Cantidad - 1)" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">-</button>
                    </form>
                    <span>@item.Cantidad</span>
                    <form asp-action="ActualizarCantidad" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idCarritoDetalle" value="@item.IdCarritoDetalle" />
                        <input type="hidden" name="cantidad" value="@(item.Cantidad + 1)" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">+</button>
                    </form>
                </div>
            </td>
            <td>S/ @item.PrecioUnitario</td>
            <td>S/ @item.SubTotal</td>
            <td>
                <form asp-action="Eliminar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idCarritoDetalle" value="@item.IdCarritoDetalle" />
                    <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="card mt-3">
    <div class="card-header">Checkout</div>
    <div class="card-body">
        <p class="fw-bold">Total: S/ @Model.Total</p>
        <form asp-action="Checkout" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label asp-for="DireccionEntrega" class="form-label"></label>
                <input asp-for="DireccionEntrega" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label asp-for="MetodoPago" class="form-label">Método de pago</label>
                <input asp-for="MetodoPago" class="form-control" placeholder="MERCADO_PAGO o CONTRAENTREGA" required />
            </div>
            <div class="col-md-4">
                <label asp-for="EmailPago" class="form-label">Email pago</label>
                <input asp-for="EmailPago" class="form-control" placeholder="cliente@correo.com" />
            </div>
            <div class="col-md-4">
                <label asp-for="MercadoPagoToken" class="form-label">Mercado Pago token</label>
                <input asp-for="MercadoPagoToken" class="form-control" placeholder="TOKEN_GENERADO_EN_FRONTEND" />
            </div>
            <div class="col-md-3">
                <label asp-for="PaymentMethodId" class="form-label">PaymentMethodId</label>
                <input asp-for="PaymentMethodId" class="form-control" placeholder="visa, master, amex..." />
            </div>
            <div class="col-md-2">
                <label asp-for="Installments" class="form-label">Cuotas</label>
                <input asp-for="Installments" class="form-control" type="number" min="1" />
            </div>
            <div class="col-md-3">
                <label asp-for="IssuerId" class="form-label">IssuerId</label>
                <input asp-for="IssuerId" class="form-control" placeholder="Opcional" />
            </div>
            <div class="col-md-2">
                <label asp-for="IdentificationType" class="form-label">Doc. tipo</label>
                <input asp-for="IdentificationType" class="form-control" placeholder="DNI" />
            </div>
            <div class="col-md-3">
                <label asp-for="IdentificationNumber" class="form-label">Doc. número</label>
                <input asp-for="IdentificationNumber" class="form-control" placeholder="12345678" />
            </div>
            <div class="col-md-3 align-self-end">
                <button class="btn btn-success" type="submit">Confirmar compra</button>
            </div>
        </form>
    </div>
</div>

}
