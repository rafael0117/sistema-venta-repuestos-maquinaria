@model SistemaRepuestosMaquinas.Web.Models.ProductoDetalleViewModel
@{
    ViewData["Title"] = "Detalle de producto";
}

<div class="product-detail card">
    <div class="card-body">
        <div class="detail-layout">
            <div>
                <div class="product-detail-image-wrap">
                    <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="product-detail-image" />
                </div>
                <div class="detail-panel mt-2">
                    <span class="detail-feature">🚚 Envío rápido a nivel nacional</span>
                    <span class="detail-feature">✅ Garantía de calidad</span>
                    <span class="detail-feature">💬 Soporte postventa</span>
                </div>
            </div>
            <div>
                <span class="product-badge">@Model.Categoria · @Model.Marca</span>
                <h2 class="mb-1">@Model.Nombre</h2>
                <p class="text-muted mb-2">Código: @Model.Codigo</p>
                <p class="mb-3">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Producto sin descripción registrada." : Model.Descripcion)</p>

                <div class="product-detail-price">S/ @Model.PrecioVenta.ToString("N2")</div>
                <p class="mb-3">
                    <span class="stock-tag @(Model.Stock > 0 ? "in" : "out")">
                        @(Model.Stock > 0 ? $"Stock disponible: {Model.Stock}" : "Sin stock disponible")
                    </span>
                </p>

                <div class="detail-panel mb-3">
                    <h4 class="mb-2">Detalle técnico</h4>
                    <ul class="detail-list">
                        <li><span>Marca</span><strong>@Model.Marca</strong></li>
                        <li><span>Categoría</span><strong>@Model.Categoria</strong></li>
                        <li><span>Código</span><strong>@Model.Codigo</strong></li>
                        <li><span>Estado</span><strong>@(Model.Stock > 0 ? "Disponible" : "Agotado")</strong></li>
                    </ul>
                </div>

                <form asp-controller="Carrito" asp-action="AgregarRapido" method="post" class="row g-2 mt-2" data-action-name="agregar este producto al carrito">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idProducto" value="@Model.IdProducto" />
                    <input type="hidden" name="returnUrl" value="/Catalogo/Detalle/@Model.IdProducto" />
                    <div class="col-md-3">
                        <label class="form-label">Cantidad</label>
                        <input name="cantidad" type="number" class="form-control" min="1" max="@Math.Max(Model.Stock,1)" value="1" />
                    </div>
                    <div class="col-md-4 align-self-end">
                        <button class="btn btn-success" type="submit" @(Model.Stock <= 0 ? "disabled" : null)>Agregar al carrito</button>
                    </div>
                    <div class="col-md-4 align-self-end">
                        <a class="btn btn-outline-secondary" asp-controller="Catalogo" asp-action="Index">Volver al catálogo</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
