@model SistemaRepuestosMaquinas.Web.Models.CatalogoPageViewModel
@{
    ViewData["Title"] = "Catálogo";
}

<section class="catalog-shell">
<div>
    <h1 class="mb-2">Catálogo de repuestos</h1>
    <p class="text-muted">Explora piezas por marca, categoría y disponibilidad en tiempo real.</p>
</div>

@if (!string.IsNullOrWhiteSpace(TempData["Message"] as string))
{
    <div class="alert @(((TempData["IsError"] as string) == "1") ? "alert-danger" : "alert-success")">@TempData["Message"]</div>
}

<div class="card catalog-toolbar">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Buscar</label>
                <input name="Texto" value="@Model.Texto" class="form-control" placeholder="Nombre o descripción" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Categoría</label>
                <select name="IdCategoria" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.Id" selected="@(Model.IdCategoria == c.Id)">@c.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Marca</label>
                <select name="IdMarca" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var m in Model.Marcas)
                    {
                        <option value="@m.Id" selected="@(Model.IdMarca == m.Id)">@m.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label">Página</label>
                <input name="Page" value="@Model.Page" type="number" min="1" max="@Model.TotalPages" class="form-control" />
            </div>

            <div class="col-md-1">
                <label class="form-label">Tamaño</label>
                <input name="PageSize" value="@Model.PageSize" type="number" min="1" max="100" class="form-control" />
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary w-100" type="submit">Filtrar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<p class="text-muted">Total encontrados: <strong>@Model.Total</strong></p>

@if (Model.Productos.Count == 0)
{
    <div class="alert alert-warning">No se encontraron productos para los filtros seleccionados.</div>
}
else
{
<div class="row g-3 catalog-grid">
@foreach (var item in Model.Productos)
{
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="catalog-card-top">
                    <span class="catalog-chip">@item.Categoria</span>
                    <span class="small text-muted">#@item.Codigo</span>
                </div>
                <img src="@item.ImagenUrl" alt="@item.Nombre" class="catalog-card-image mb-2" />
                <h5 class="card-title">@item.Nombre</h5>
                <div class="catalog-meta small">
                    <p class="card-text mb-1"><strong>Marca:</strong> @item.Marca</p>
                    <p class="card-text mb-1">@item.Descripcion</p>
                </div>
                <p class="price-tag">S/ @item.PrecioVenta.ToString("N2")</p>
                <span class="stock-tag @(item.Stock > 0 ? "in" : "out")">
                    @(item.Stock > 0 ? $"Stock disponible: {item.Stock}" : "Sin stock")
                </span>

                <div class="mt-auto d-flex gap-2">
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Catalogo" asp-action="Detalle" asp-route-idProducto="@item.IdProducto">Ver detalle</a>
                    <form asp-controller="Carrito" asp-action="AgregarRapido" method="post" class="d-inline" data-action-name="agregar este producto al carrito">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idProducto" value="@item.IdProducto" />
                        <input type="hidden" name="cantidad" value="1" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button class="btn btn-success btn-sm" type="submit" @(item.Stock <= 0 ? "disabled" : null)>Agregar al carrito</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
</div>

<nav class="mt-3" aria-label="Paginación de catálogo">
    <ul class="pagination">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
            <a class="page-link" asp-action="Index" asp-route-Texto="@Model.Texto" asp-route-IdCategoria="@Model.IdCategoria" asp-route-IdMarca="@Model.IdMarca" asp-route-Page="@(Model.Page - 1)" asp-route-PageSize="@Model.PageSize">Anterior</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Página @Model.Page de @Model.TotalPages</span></li>
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
            <a class="page-link" asp-action="Index" asp-route-Texto="@Model.Texto" asp-route-IdCategoria="@Model.IdCategoria" asp-route-IdMarca="@Model.IdMarca" asp-route-Page="@(Model.Page + 1)" asp-route-PageSize="@Model.PageSize">Siguiente</a>
        </li>
    </ul>
</nav>
}
</section>
