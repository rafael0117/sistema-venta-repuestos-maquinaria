@model SistemaRepuestosMaquinas.Web.Models.CuentaPageViewModel
@{
    ViewData["Title"] = "Cuenta";
}

<h1 class="mb-3">Cuenta</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Iniciar sesión</div>
            <div class="card-body">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label asp-for="Login.Correo" class="form-label"></label>
                        <input asp-for="Login.Correo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Login.Password" class="form-label"></label>
                        <input asp-for="Login.Password" class="form-control" />
                    </div>
                    <button class="btn btn-primary" type="submit">Ingresar</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Crear cuenta</div>
            <div class="card-body">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label asp-for="Register.Nombres" class="form-label"></label>
                        <input asp-for="Register.Nombres" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.Apellidos" class="form-label"></label>
                        <input asp-for="Register.Apellidos" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.Correo" class="form-label"></label>
                        <input asp-for="Register.Correo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Register.Password" class="form-label"></label>
                        <input asp-for="Register.Password" class="form-control" />
                    </div>
                    <button class="btn btn-success" type="submit">Registrarme</button>
                </form>
            </div>
        </div>
    </div>
</div>

<form asp-action="Logout" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-secondary">Cerrar sesión</button>
</form>
