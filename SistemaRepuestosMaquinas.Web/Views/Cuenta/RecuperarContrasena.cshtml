@model SistemaRepuestosMaquinas.Web.Models.ForgotPasswordPageViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<section class="auth-hero mb-3">
    <div>
        <p class="eyebrow">RECUPERACIÓN</p>
        <h1>Recuperar contraseña</h1>
        <p class="text-muted">Te enviaremos un enlace seguro al correo registrado.</p>
    </div>
    <div class="hero-pill">Enlace temporal</div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
}

<div class="row g-4 auth-grid-single">
    <div class="col-md-6 auth-center-col">
        <div class="card auth-card auth-card-login">
            <div class="card-header">Solicitar recuperación</div>
            <div class="card-body">
                <form asp-action="SolicitarRecuperacion" method="post" class="auth-form">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="ForgotPassword.Correo" class="form-label">Correo electrónico</label>
                        <input asp-for="ForgotPassword.Correo" class="form-control" placeholder="correo@empresa.com" />
                        <span asp-validation-for="ForgotPassword.Correo" class="field-validation-error"></span>
                    </div>
                    <button class="btn btn-primary auth-btn" type="submit">Enviar enlace</button>
                </form>
                <div class="auth-links mt-3">
                    <a asp-action="Index">Volver al inicio de sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>
