@model SistemaRepuestosMaquinas.Web.Models.RegisterPageViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="auth-hero mb-3">
    <div>
        <p class="eyebrow">NUEVA CUENTA</p>
        <h1>Registro de cliente</h1>
        <p class="text-muted">Completa tus datos para crear una cuenta más segura y completa.</p>
    </div>
    <div class="hero-pill">Validación reforzada</div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
}

<div class="row g-4 auth-grid-single">
    <div class="col-md-6 auth-center-col">
        <div class="card auth-card auth-card-register">
            <div class="card-header">Crear cuenta</div>
            <div class="card-body">
                <form asp-action="Register" method="post" class="auth-form">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label asp-for="Register.Nombres" class="form-label">Nombres</label>
                        <input asp-for="Register.Nombres" class="form-control" placeholder="Nombres" />
                        <span asp-validation-for="Register.Nombres" class="field-validation-error"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.Apellidos" class="form-label">Apellidos</label>
                        <input asp-for="Register.Apellidos" class="form-control" placeholder="Apellidos" />
                        <span asp-validation-for="Register.Apellidos" class="field-validation-error"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.Correo" class="form-label">Correo electrónico</label>
                        <input asp-for="Register.Correo" class="form-control" placeholder="correo@empresa.com" />
                        <span asp-validation-for="Register.Correo" class="field-validation-error"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.Telefono" class="form-label">Teléfono</label>
                        <input asp-for="Register.Telefono" class="form-control" placeholder="987654321" />
                        <span asp-validation-for="Register.Telefono" class="field-validation-error"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.TipoDocumento" class="form-label">Tipo de documento</label>
                        <select asp-for="Register.TipoDocumento" class="form-control">
                            <option value="DNI">DNI</option>
                            <option value="RUC">RUC</option>
                            <option value="CE">Carné de extranjería</option>
                        </select>
                        <span asp-validation-for="Register.TipoDocumento" class="field-validation-error"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.NumeroDocumento" class="form-label">Número de documento</label>
                        <input asp-for="Register.NumeroDocumento" class="form-control" placeholder="Documento" />
                        <span asp-validation-for="Register.NumeroDocumento" class="field-validation-error"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.Direccion" class="form-label">Dirección</label>
                        <input asp-for="Register.Direccion" class="form-control" placeholder="Dirección completa" />
                        <span asp-validation-for="Register.Direccion" class="field-validation-error"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Register.Password" class="form-label">Contraseña</label>
                        <input asp-for="Register.Password" class="form-control" placeholder="Mínimo 8 caracteres" />
                        <span asp-validation-for="Register.Password" class="field-validation-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Register.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="Register.ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" />
                        <span asp-validation-for="Register.ConfirmPassword" class="field-validation-error"></span>
                    </div>
                    <button class="btn btn-success auth-btn" type="submit">Crear mi cuenta</button>
                </form>

                <div class="auth-links mt-3">
                    <a asp-action="Index">Ya tengo cuenta, iniciar sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>
