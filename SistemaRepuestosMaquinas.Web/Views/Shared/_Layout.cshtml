@using SistemaRepuestosMaquinas.Common.Constants
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var rol = HttpContextAccessor.HttpContext?.Session.GetString("rol");
    var isAuthenticated = !string.IsNullOrWhiteSpace(HttpContextAccessor.HttpContext?.Session.GetString("jwt"));
    var showAdmin = string.Equals(rol, Roles.Administrador, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Repuestos</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header class="topbar">
        <div class="container nav-wrap">
            <a class="brand" asp-controller="Home" asp-action="Index">🛠️ REPUESTOS MAQUINARIA</a>
            <nav class="nav-links">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                <a asp-controller="Carrito" asp-action="Index">Carrito</a>
                @if (isAuthenticated)
                {
                    <form asp-controller="Cuenta" asp-action="Logout" method="post" class="nav-logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link-btn">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Cuenta" asp-action="Index">Login</a>
                    <a asp-controller="Cuenta" asp-action="Registro">Registro</a>
                }

                @if (showAdmin)
                {
                    <a asp-controller="AdminDashboard" asp-action="Index">Panel Admin</a>
                }
            </nav>
        </div>
    </header>

    <main class="container content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <p>© @DateTime.Now.Year SistemaRepuestosMaquinas · Soluciones para maquinaria industrial</p>
        </div>
    </footer>

    <script>
        (() => {
            const getAlertType = (el) => {
                if (el.classList.contains('alert-danger')) return 'error';
                if (el.classList.contains('alert-warning')) return 'warning';
                return 'success';
            };

            const getAlertTitle = (type) => {
                if (type === 'error') return 'Acción incorrecta';
                if (type === 'warning') return 'Advertencia';
                return 'Acción correcta';
            };

            const inlineAlerts = document.querySelectorAll('.alert');
            inlineAlerts.forEach((alertEl) => {
                const text = (alertEl.textContent || '').trim();
                if (!text) return;

                const type = getAlertType(alertEl);
                Swal.fire({
                    icon: type,
                    title: getAlertTitle(type),
                    text,
                    confirmButtonText: 'Entendido'
                });
            });

            document.querySelectorAll('form[method="post"]').forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    if (form.dataset.confirmed === '1') return;
                    if (form.hasAttribute('data-skip-global-confirm')) return;
                    if ((form.getAttribute('onsubmit') || '').toLowerCase().includes('confirm(')) return;

                    event.preventDefault();
                    const actionName = form.getAttribute('data-action-name') || 'esta acción';

                    const result = await Swal.fire({
                        icon: 'warning',
                        title: '¿Deseas continuar?',
                        text: `Vas a ejecutar ${actionName}.`,
                        showCancelButton: true,
                        confirmButtonText: 'Sí, continuar',
                        cancelButtonText: 'Cancelar'
                    });

                    if (result.isConfirmed) {
                        form.dataset.confirmed = '1';
                        Swal.fire({
                            icon: 'info',
                            title: 'Procesando',
                            text: 'Estamos ejecutando tu acción...'
                        });
                        form.submit();
                    } else {
                        Swal.fire({
                            icon: 'info',
                            title: 'Acción cancelada',
                            text: 'No se realizaron cambios.'
                        });
                    }
                });
            });
        })();
    </script>
</body>
</html>
