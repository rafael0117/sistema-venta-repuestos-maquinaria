@using SistemaRepuestosMaquinas.Common.Constants
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var rol = HttpContextAccessor.HttpContext?.Session.GetString("rol");
    var isAuthenticated = !string.IsNullOrWhiteSpace(HttpContextAccessor.HttpContext?.Session.GetString("jwt"));
    var showAdmin = string.Equals(rol, Roles.Administrador, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Repuestos</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header class="topbar">
        <div class="container nav-wrap">
            <a class="brand" asp-controller="Home" asp-action="Index">🛠️ Repuestos Maquinaria Pro</a>
            <nav class="nav-links">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                <a asp-controller="Carrito" asp-action="Index">Carrito</a>
                @if (isAuthenticated)
                {
                    <form asp-controller="Cuenta" asp-action="Logout" method="post" class="nav-logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link-btn">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Cuenta" asp-action="Index">Login</a>
                    <a asp-controller="Cuenta" asp-action="Registro">Registro</a>
                }

                @if (showAdmin)
                {
                    <a asp-controller="AdminDashboard" asp-action="Index">Panel Admin</a>
                }
            </nav>
        </div>
    </header>

    <main class="container content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <p>© @DateTime.Now.Year Sistema Repuestos · Plataforma comercial para maquinaria industrial</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (() => {
            const getAlertType = (el, text) => {
                if (el.classList.contains('alert-danger')) return 'error';
                if (el.classList.contains('alert-warning')) return 'warning';
                if (/error|inválid|incorrect|fall|no se pudo/i.test(text)) return 'error';
                if (/advertencia|atención|cuidado/i.test(text)) return 'warning';
                return 'success';
            };

            const getAlertTitle = (type, text) => {
                if (/iniciada|bienvenido|sesión cerrada/i.test(text)) return 'Sesión';
                if (type === 'error') return 'Acción incorrecta';
                if (type === 'warning') return 'Advertencia';
                return 'Acción correcta';
            };

            const inferActionMeta = (form) => {
                const action = (form.getAttribute('action') || '').toLowerCase();
                const buttonText = (form.querySelector('button[type="submit"]')?.textContent || '').trim().toLowerCase();

                if (action.includes('/cuenta/login')) return { ask: false, done: 'Inicio de sesión enviado.' };
                if (action.includes('/cuenta/registro')) return { ask: false, done: 'Registro enviado.' };
                if (action.includes('/cuenta/recuperarcontrasena')) return { ask: false, done: 'Solicitud enviada.' };
                if (action.includes('/cuenta/restablecercontrasena')) return { ask: false, done: 'Restablecimiento enviado.' };

                if (action.includes('delete') || buttonText.includes('eliminar'))
                    return { ask: true, question: '¿Seguro que deseas eliminar este registro?', actionLabel: 'eliminación' };

                if (action.includes('toggleestado') || buttonText.includes('estado'))
                    return { ask: true, question: '¿Deseas cambiar el estado (Activo/Inactivo)?', actionLabel: 'cambio de estado' };

                if (action.includes('resetpassword') || buttonText.includes('reset'))
                    return { ask: true, question: '¿Deseas restablecer la contraseña de este usuario?', actionLabel: 'restablecer contraseña' };

                if (action.includes('update') || buttonText.includes('guardar') || buttonText.includes('actualizar'))
                    return { ask: true, question: '¿Guardar los cambios realizados?', actionLabel: 'actualización' };

                if (action.includes('create') || buttonText.includes('crear'))
                    return { ask: true, question: '¿Deseas crear este nuevo registro?', actionLabel: 'creación' };

                if (action.includes('agregarrapido') || buttonText.includes('carrito') || buttonText.includes('agregar'))
                    return { ask: true, question: '¿Agregar este producto al carrito?', actionLabel: 'agregar al carrito' };

                return { ask: true, question: '¿Deseas continuar con esta acción?', actionLabel: 'acción' };
            };

            const inlineAlerts = document.querySelectorAll('.alert');
            inlineAlerts.forEach((alertEl) => {
                const text = (alertEl.textContent || '').trim();
                if (!text) return;

                const type = getAlertType(alertEl, text);
                Swal.fire({
                    icon: type,
                    title: getAlertTitle(type, text),
                    text,
                    confirmButtonText: 'Entendido'
                });
            });

            document.querySelectorAll('form[method="post"]').forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    if (form.dataset.confirmed === '1') return;
                    if (form.hasAttribute('data-skip-global-confirm')) return;
                    if ((form.getAttribute('onsubmit') || '').toLowerCase().includes('confirm(')) return;

                    const meta = inferActionMeta(form);
                    if (!meta.ask) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Procesando',
                            text: meta.done ?? 'Procesando solicitud...'
                        });
                        return;
                    }

                    event.preventDefault();

                    const result = await Swal.fire({
                        icon: 'question',
                        title: 'Confirma la acción',
                        text: meta.question,
                        showCancelButton: true,
                        confirmButtonText: 'Sí, continuar',
                        cancelButtonText: 'Cancelar'
                    });

                    if (result.isConfirmed) {
                        form.dataset.confirmed = '1';
                        Swal.fire({
                            icon: 'info',
                            title: 'Procesando',
                            text: `Ejecutando ${meta.actionLabel}...`
                        });
                        form.submit();
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Acción cancelada',
                            text: 'No se realizaron cambios.'
                        });
                    }
                });
            });
        })();
    </script>
</body>
</html>
